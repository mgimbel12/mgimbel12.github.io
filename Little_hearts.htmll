<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Little Girls, Big Hearts</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Segoe UI", system-ui, sans-serif;
    }

    body {
      background: linear-gradient(to bottom, #0b3c7d, #ffffff 40%, #c8102e 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      color: #222;
    }

    header {
      text-align: center;
      padding: 20px 10px;
      color: #fff;
      position: relative;
    }

    header h1 {
      font-size: 2.4rem;
      letter-spacing: 2px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }

    .ribbon-bar {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 15px;
    }

    .ribbon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 0.75rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .ribbon.blue {
      background: #0b3c7d;
    }

    .ribbon.white {
      background: #ffffff;
      color: #0b3c7d;
      border: 3px solid #0b3c7d;
    }

    .ribbon.red {
      background: #c8102e;
    }

    .ribbon::before,
    .ribbon::after {
      content: "";
      position: absolute;
      width: 20px;
      height: 60px;
      background: inherit;
      bottom: -40px;
      clip-path: polygon(0 0, 100% 0, 50% 100%);
    }

    .ribbon::before {
      left: 5px;
      transform: rotate(-5deg);
    }

    .ribbon::after {
      right: 5px;
      transform: rotate(5deg);
    }

    main {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 30px 15px 40px;
    }

    .card {
      max-width: 800px;
      width: 100%;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 16px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      padding: 25px 25px 30px;
      border: 3px solid #0b3c7d;
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 8px double #c8102e;
      opacity: 0.4;
    }

    .card::after {
      content: "";
      position: absolute;
      bottom: -40px;
      left: -40px;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 8px double #0b3c7d;
      opacity: 0.4;
    }

    .bow {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 120px;
      height: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .bow-part {
      width: 50px;
      height: 50px;
      border-radius: 50% 10% 50% 10%;
      background: linear-gradient(135deg, #c8102e, #0b3c7d);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .bow-part.right {
      transform: scaleX(-1);
    }

    .bow-center {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #ffffff;
      border: 3px solid #0b3c7d;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
    }

    .poem-title {
      text-align: center;
      margin-top: 30px;
      font-size: 1.6rem;
      color: #0b3c7d;
      letter-spacing: 1px;
    }

    .poem-subtitle {
      text-align: center;
      margin-top: 5px;
      font-size: 0.95rem;
      color: #555;
    }

    .poem {
      margin-top: 25px;
      line-height: 1.8;
      font-size: 1.05rem;
      color: #333;
      text-align: center;
    }

    .poem span.line {
      display: block;
      margin-bottom: 6px;
    }

    .highlight {
      color: #c8102e;
      font-weight: 600;
    }

    .kindness-banner {
      margin-top: 25px;
      padding: 12px 16px;
      border-radius: 999px;
      background: linear-gradient(to right, #0b3c7d, #ffffff, #c8102e);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      color: #0b3c7d;
      font-weight: 600;
      font-size: 0.95rem;
      flex-wrap: wrap;
    }

    .kindness-tag {
      background: rgba(255, 255, 255, 0.9);
      border-radius: 999px;
      padding: 6px 12px;
      border: 1px solid #0b3c7d;
      color: #c8102e;
      font-size: 0.85rem;
    }

    .footer-note {
      margin-top: 20px;
      text-align: center;
      font-size: 0.9rem;
      color: #555;
    }

    footer {
      text-align: center;
      padding: 10px 0 18px;
      font-size: 0.8rem;
      color: #f5f5f5;
    }

    .pulse {
      animation: pulse 2.5s infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.6);
      }
      50% {
        transform: scale(1.05);
        box-shadow: 0 0 0 12px rgba(200, 16, 46, 0);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(200, 16, 46, 0);
      }
    }

    .armed-forces {
      margin-top: 18px;
      text-align: center;
      font-size: 0.9rem;
      color: #0b3c7d;
      font-weight: 600;
    }

    .armed-forces span {
      color: #c8102e;
    }

    .btn-row {
      margin-top: 22px;
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      padding: 10px 18px;
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .btn.red {
      background: #c8102e;
      color: #fff;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .btn.white {
      background: #ffffff;
      color: #0b3c7d;
      border: 2px solid #0b3c7d;
    }

    .btn.blue {
      background: #0b3c7d;
      color: #fff;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.35);
    }

    .btn:active {
      transform: translateY(0);
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
    }

    .message-bar {
      margin-top: 15px;
      text-align: center;
      font-size: 0.9rem;
      color: #0b3c7d;
      min-height: 1.2em;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 1.8rem;
      }
      .card {
        padding: 20px 15px 25px;
      }
      .poem {
        font-size: 0.98rem;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>Red, White & Blue Ribbons of Love</h1>
    <div class="ribbon-bar">
      <div class="ribbon blue">Kindness</div>
      <div class="ribbon white">Love</div>
      <div class="ribbon red">Courage</div>
    </div>
  </header>

  <main>
    <section class="card">
      <div class="bow">
        <div class="bow-part"></div>
        <div class="bow-center pulse"></div>
        <div class="bow-part right"></div>
      </div>

      <h2 class="poem-title">Little Girls, Big Hearts</h2>
      <p class="poem-subtitle">
        For every child who deserves friends, family, and a world full of gentle laughter.
      </p>

      <div class="poem">
        <span class="line">Little girls with ribboned hair,</span>
        <span class="line">Dream of hearts that truly care.</span>
        <span class="line">Hands that hold and never shove,</span>
        <span class="line">Different colors, one same love.</span>

        <span class="line">Red for courage, brave and bright,</span>
        <span class="line">White for hope and gentle light.</span>
        <span class="line">Blue for peace that softly stays,</span>
        <span class="line">Guarding all their growing days.</span>

        <span class="line">Every girl deserves a friend,</span>
        <span class="line">Family warmth that doesn’t end.</span>
        <span class="line">Fun and laughter, songs that rise,</span>
        <span class="line">Stars of kindness in their skies.</span>

        <span class="line">When we choose a loving way,</span>
        <span class="line">Do good deeds in what we say,</span>
        <span class="line">Life returns a gentle glow—</span>
        <span class="line highlight">Good things bloom from good we sow.</span>

        <span class="line">Arm in arm, our forces strong,</span>
        <span class="line">Standing up for right, not wrong.</span>
        <span class="line">Every heart, in every land,</span>
        <span class="line">Deserves a kind and open hand.</span>
      </div>

      <div class="kindness-banner">
        <span>We all deserve friends and family.</span>
        <span class="kindness-tag">Fun</span>
        <span class="kindness-tag">Laughter</span>
        <span class="kindness-tag">Love</span>
        <span class="kindness-tag">Kindness</span>
        <span class="kindness-tag">Good Deeds</span>
      </div>

      <div class="armed-forces">
        Honoring <span>all armed forces</span> who protect with courage, compassion, and care.
      </div>

      <div class="btn-row">
        <button class="btn red" id="kindnessBtn">Share a Kind Thought</button>
        <button class="btn white" id="gratitudeBtn">Send Gratitude</button>
        <button class="btn blue" id="hopeBtn">Promise to Do Good</button>
      </div>

      <div class="message-bar" id="messageBar"></div>

      <p class="footer-note">
        Different versions of love, one simple truth: when we do kind things, the world becomes kinder back.
      </p>
    </section>
  </main>

  <footer>
    &copy; 2026 Ribbons of Love • For every little girl who deserves the best of us.
  </footer>

  <script>
    const messageBar = document.getElementById("messageBar");
    const messages = {
      kindness: "Your kind thought can be the ribbon that ties someone’s heart to hope.",
      gratitude: "Gratitude is a quiet bow of respect—thank you for choosing to see the good.",
      hope: "Every good deed is a promise: the world can be softer, safer, and more loving."
    };

    document.getElementById("kindnessBtn").addEventListener("click", () => {
      messageBar.textContent = messages.kindness;
    });

    document.getElementById("gratitudeBtn").addEventListener("click", () => {
      messageBar.textContent = messages.gratitude;
    });

    document.getElementById("hopeBtn").addEventListener("click", () => {
      messageBar.textContent = messages.hope;
    });
  </script>
</body>
</html>
